#!/usr/bin/env sh
# Composer bin wrapper for blink, the Go coding-standard tool.
# In a release it execs the bundled per-platform binary (bin/blink-<os>-<arch>).
# In the source repo it builds from blink/ on first run (Go required).
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"

os=$(uname -s)
arch=$(uname -m)
case "$os" in
    Linux) os=linux ;;
    Darwin) os=darwin ;;
    *) os= ;;
esac
case "$arch" in
    x86_64 | amd64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) arch= ;;
esac

if [ -n "$os" ] && [ -n "$arch" ] && [ -x "$DIR/blink-$os-$arch" ]; then
    exec "$DIR/blink-$os-$arch" "$@"
fi

# source checkout: build from the blink/ Go module
SRC="$DIR/../blink"
if [ -d "$SRC" ]; then
    BINARY="$SRC/blink"
    if [ ! -x "$BINARY" ]; then
        if ! command -v go >/dev/null 2>&1; then
            echo "blink: Go toolchain required to build from source (https://go.dev/dl)" >&2
            exit 1
        fi
        (cd "$SRC" && go build -o "$BINARY" .)
    fi
    exec "$BINARY" "$@"
fi

echo "blink: no bundled binary for $os-$arch and no blink/ source to build from" >&2
exit 1
